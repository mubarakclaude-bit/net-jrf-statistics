{
  "buildCommand": "bash build.sh && node build_site.js",
  "outputDirectory": "site",
  "installCommand": "echo no dependencies to install",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/data.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  }
}
