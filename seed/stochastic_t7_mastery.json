    {
      "id": "stochastic-t7-m-01",
      "diff": "easy",
      "format": "single",
      "topic": "stochastic-t7",
      "stem": "A birth in a birth–death process changes state n to:",
      "options": [
        "n+1",
        "n−1",
        "n",
        "0"
      ],
      "answer": "A",
      "explanation": "A birth increases the state by one."
    },
    {
      "id": "stochastic-t7-m-02",
      "diff": "easy",
      "format": "single",
      "topic": "stochastic-t7",
      "stem": "In a queue-length birth–death model, a service completion is a:",
      "options": [
        "Death",
        "Birth",
        "Self-transition",
        "Absorption"
      ],
      "answer": "A",
      "explanation": "A service completion reduces the number in the system by one."
    },
    {
      "id": "stochastic-t7-m-03",
      "diff": "easy",
      "format": "single",
      "topic": "stochastic-t7",
      "stem": "For an M/M/1 queue, ρ is:",
      "options": [
        "λ/μ",
        "μ/λ",
        "λ+μ",
        "λμ"
      ],
      "answer": "A",
      "explanation": "Utilisation is arrival rate divided by service rate."
    },
    {
      "id": "stochastic-t7-m-04",
      "diff": "easy",
      "format": "single",
      "topic": "stochastic-t7",
      "stem": "The stability condition for an M/M/1 queue is:",
      "options": [
        "λ<μ",
        "λ>μ",
        "λ=μ",
        "λ≤μ"
      ],
      "answer": "A",
      "explanation": "A stationary distribution requires ρ<1."
    },
    {
      "id": "stochastic-t7-m-05",
      "diff": "easy",
      "format": "single",
      "topic": "stochastic-t7",
      "stem": "For a stable M/M/1 queue, the empty-system probability is:",
      "options": [
        "1−ρ",
        "ρ",
        "1/ρ",
        "1+ρ"
      ],
      "answer": "A",
      "explanation": "P₀=1−ρ."
    },
    {
      "id": "stochastic-t7-m-06",
      "diff": "easy",
      "format": "numeric",
      "topic": "stochastic-t7",
      "stem": "If λ=3 and μ=6 per hour, what is ρ?",
      "options": [
        "0.25",
        "0.5",
        "0.75",
        "2"
      ],
      "answer": "B",
      "explanation": "ρ=3/6=0.5.",
      "check": "0.5"
    },
    {
      "id": "stochastic-t7-m-07",
      "diff": "moderate",
      "format": "single",
      "topic": "stochastic-t7",
      "stem": "The stationary local-balance relation between states n and n+1 is:",
      "options": [
        "π_nμ_n=π_{n+1}μ_{n+1}",
        "π_nλ_n=π_{n+1}μ_{n+1}",
        "π_n=π_{n+1}",
        "λ_n=μ_n"
      ],
      "answer": "B",
      "explanation": "Equilibrium flow upward equals flow downward between adjacent states."
    },
    {
      "id": "stochastic-t7-m-08",
      "diff": "moderate",
      "format": "single",
      "topic": "stochastic-t7",
      "stem": "For a stable M/M/1 queue, P(N=2) equals:",
      "options": [
        "ρ²",
        "(1−ρ)ρ²",
        "(1−ρ)ρ",
        "1−ρ²"
      ],
      "answer": "B",
      "explanation": "The stationary law is geometric: π_n=(1−ρ)ρⁿ."
    },
    {
      "id": "stochastic-t7-m-09",
      "diff": "moderate",
      "format": "single",
      "topic": "stochastic-t7",
      "stem": "For an M/M/1 queue, L is:",
      "options": [
        "ρ²/(1−ρ)",
        "ρ/(1−ρ)",
        "1/(μ−λ)",
        "λ/μ"
      ],
      "answer": "B",
      "explanation": "L is the mean number in the whole system."
    },
