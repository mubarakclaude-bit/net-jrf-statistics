    {
      "id": "sampling-t9-m01",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t9",
      "stem": "An unbiased variance estimator can be negative because:",
      "options": [
        "Unbiasedness concerns expectation, not each realised value",
        "True variance can be negative",
        "All samples have negative variance",
        "Inclusion probabilities are always negative"
      ],
      "answer": "A",
      "explanation": "An unbiased estimator can take negative values in individual samples."
    },
    {
      "id": "sampling-t9-m02",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t9",
      "stem": "The true variance is:",
      "options": [
        "Always negative",
        "Always nonnegative",
        "Zero for every sample",
        "Unrelated to squared deviations"
      ],
      "answer": "B",
      "explanation": "Variance is an expectation of a squared deviation."
    },
    {
      "id": "sampling-t9-m03",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t9",
      "stem": "Define Δ_ij as:",
      "options": [
        "π_ij−π_i−π_j",
        "π_iπ_j−π_ij",
        "π_i+π_j",
        "π_i/π_j"
      ],
      "answer": "B",
      "explanation": "The SYG coefficient uses the difference between product and joint inclusion probabilities."
    },
    {
      "id": "sampling-t9-m04",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t9",
      "stem": "The SYG estimator is expressed as a sum of:",
      "options": [
        "Absolute values",
        "Squared differences with pair coefficients",
        "Only first-order probabilities",
        "Sample medians"
      ],
      "answer": "B",
      "explanation": "The SYG form weights squared differences of inverse-probability values."
    },
    {
      "id": "sampling-t9-m05",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t9",
      "stem": "A sufficient pairwise condition for nonnegative SYG terms is:",
      "options": [
        "π_ij>π_iπ_j",
        "π_ij≤π_iπ_j with π_ij>0",
        "π_i=0",
        "π_ij=0"
      ],
      "answer": "B",
      "explanation": "Then each coefficient (π_iπ_j−π_ij)/π_ij is nonnegative."
    },
    {
      "id": "sampling-t9-m06",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t9",
      "stem": "Des Raj's estimator is called ordered because it:",
      "options": [
        "Uses only unordered pairs",
        "Depends on the order of selection",
        "Ignores all draw probabilities",
        "Is an SRS estimator"
      ],
      "answer": "B",
      "explanation": "The previous draws enter the adjusted term at each draw."
    },
