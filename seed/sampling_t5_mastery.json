    {
      "id": "sampling-t5-m01",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t5",
      "stem": "For N divisible by n, the systematic interval is:",
      "options": [
        "N/n",
        "n/N",
        "N−n",
        "N+n"
      ],
      "answer": "A",
      "explanation": "The interval is the frame size divided by the sample size."
    },
    {
      "id": "sampling-t5-m02",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t5",
      "stem": "In the standard linear design, the random start is selected from:",
      "options": [
        "1,…,N",
        "1,…,k",
        "0,…,n",
        "Any real number"
      ],
      "answer": "B",
      "explanation": "The start is selected uniformly from the first k positions."
    },
    {
      "id": "sampling-t5-m03",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t5",
      "stem": "For N=nk, the first-order inclusion probability is:",
      "options": [
        "1/N",
        "n",
        "1/k",
        "k"
      ],
      "answer": "C",
      "explanation": "Each unit is selected by exactly one of the k possible starts."
    },
    {
      "id": "sampling-t5-m04",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t5",
      "stem": "A major risk of systematic sampling is:",
      "options": [
        "No randomisation",
        "The sample always has unequal size",
        "Unequal first-order probabilities",
        "Periodicity aligned with the interval"
      ],
      "answer": "D",
      "explanation": "A repeating frame pattern can align with the fixed interval."
    },
    {
      "id": "sampling-t5-m05",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t5",
      "stem": "How many possible samples exist when N=nk?",
      "options": [
        "N",
        "All size-n subsets",
        "n",
        "k"
      ],
      "answer": "D",
      "explanation": "There is one systematic sample for each possible start."
    },
    {
      "id": "sampling-t5-m06",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t5",
      "stem": "Successive positions are obtained by:",
      "options": [
        "Subtracting k repeatedly",
        "Choosing new random positions",
        "Multiplying by N",
        "Adding k repeatedly"
      ],
      "answer": "D",
      "explanation": "The fixed interval is added to obtain each successive position."
    },
