      "diff": "easy",
      "format": "single",
      "topic": "sampling-t7",
      "stem": "A primary sampling unit is:",
      "options": [
        "The first-stage selected unit",
        "Always the final respondent",
        "The study variable",
        "The second-phase sample"
      ],
      "answer": "A",
      "explanation": "A PSU is selected at the first stage."
    },
    {
      "id": "sampling-t7-m02",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t7",
      "stem": "A secondary sampling unit is selected:",
      "options": [
        "Before the PSU",
        "From phase-two response",
        "Only in a census",
        "Within a sampled PSU"
      ],
      "answer": "D",
      "explanation": "SSUs are selected conditionally within sampled PSUs."
    },
    {
      "id": "sampling-t7-m03",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t7",
      "stem": "Multistage sampling refers to:",
      "options": [
        "Several levels of unit selection",
        "Several questionnaire pages",
        "Repeated measurements only",
        "A single-stage census"
      ],
      "answer": "A",
      "explanation": "Multistage designs select units through successive levels."
    },
    {
      "id": "sampling-t7-m04",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t7",
      "stem": "Double sampling usually refers to:",
      "options": [
        "Two geographical levels only",
        "Sampling without replacement",
        "Two estimators for one sample",
        "Two phases of measurement"
      ],
      "answer": "D",
      "explanation": "Double sampling uses a first-phase sample and a subsample for further measurement."
    },
    {
      "id": "sampling-t7-m05",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t7",
      "stem": "Overall inclusion probability in a sequential design is found by:",
      "options": [
        "Adding conditional probabilities",
        "Taking their maximum",
        "Subtracting stage probabilities",
        "Multiplying conditional probabilities"
      ],
      "answer": "D",
      "explanation": "The unit must be selected at every stage along its path."
    },
    {
      "id": "sampling-t7-m06",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t7",
      "stem": "In two-phase sampling, phase two is generally:",
      "options": [
        "A subsample of phase one",
        "Independent of phase one",
        "The population census",
        "A new PSU hierarchy"
      ],
      "answer": "A",
      "explanation": "Detailed measurement is taken on a subsample of phase-one units."
    },
