      "format": "numeric",
      "topic": "sampling-t8",
      "stem": "In 100 completed interviews, 12 respondents leave the income item blank. Find the item nonresponse rate.",
      "options": [
        "8%",
        "10%",
        "12%",
        "18%"
      ],
      "answer": "C",
      "explanation": "12/100=12%."
    },
    {
      "id": "sampling-t8-m10",
      "diff": "moderate",
      "format": "single",
      "topic": "sampling-t8",
      "stem": "Which statement about response rate and bias is correct?",
      "options": [
        "High response rate guarantees no bias",
        "Response rate alone does not determine nonresponse bias",
        "Low response rate proves severe bias",
        "Response rate measures sampling variance"
      ],
      "answer": "B",
      "explanation": "Bias depends on how response propensities relate to survey outcomes."
    },
    {
      "id": "sampling-t8-m11",
      "diff": "moderate",
      "format": "single",
      "topic": "sampling-t8",
      "stem": "A question records an irrelevant construct instead of the target concept. This is primarily:",
      "options": [
        "Specification error",
        "Sampling error",
        "Unit nonresponse",
        "Overcoverage"
      ],
      "answer": "A",
      "explanation": "The operational measure does not match the intended concept."
    },
    {
      "0": "Censuses can have non-sampling errors.",
      "1": "Increasing sample size automatically removes measurement bias.",
      "2": "Item nonresponse differs from unit nonresponse.",
