  "label": "Non-sampling errors — mastery test (unseen)",
  "count": 20,
  "items": [
    {
      "id": "sampling-t8-m01",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t8",
      "stem": "Sampling error arises because:",
      "options": [
        "The frame contains duplicates",
        "A question is ambiguous",
        "A code is entered incorrectly",
        "A sample rather than the entire population is observed"
      ],
      "answer": "D",
      "explanation": "Sampling error is variation associated with observing a sample."
    },
    {
      "id": "sampling-t8-m02",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t8",
      "stem": "Undercoverage occurs when:",
      "options": [
        "Ineligible units are duplicated",
        "A value is mistyped",
        "Respondents skip an item",
        "Eligible units are absent from the frame"
      ],
      "answer": "D",
      "explanation": "Undercoverage omits eligible target units."
    },
    {
      "id": "sampling-t8-m03",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t8",
      "stem": "Unit nonresponse means:",
      "options": [
        "One question is skipped",
        "A respondent misremembers a value",
        "A wrong code is entered",
        "A selected eligible unit provides no interview"
      ],
      "answer": "D",
      "explanation": "The whole selected case does not respond."
    },
    {
      "id": "sampling-t8-m04",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t8",
      "stem": "Item nonresponse occurs when:",
      "options": [
        "The entire household refuses",
        "A record is duplicated",
        "The frame omits a settlement",
        "The respondent skips a particular question"
      ],
      "answer": "D",
      "explanation": "The unit participates but a requested item is missing."
    },
    {
      "id": "sampling-t8-m05",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t8",
      "stem": "A census can contain:",
      "options": [
        "No errors of any kind",
        "Only sampling error",
        "Non-sampling errors",
        "No coverage error"
      ],
      "answer": "C",
      "explanation": "Census operations remain vulnerable to non-sampling errors."
    },
    {
      "id": "sampling-t8-m06",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t8",
      "stem": "A data-entry coding mistake is usually:",
      "options": [
        "Coverage error",
        "Measurement error",
        "Processing error",
        "Sampling error"
      ],
      "answer": "C",
      "explanation": "It is introduced during data handling after collection."
    },
