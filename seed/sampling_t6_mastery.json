  "label": "PPS schemes and estimators — mastery test (unseen)",
  "count": 20,
  "items": [
    {
      "id": "sampling-t6-m01",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t6",
      "stem": "In PPS sampling, selection probabilities are related to:",
      "options": [
        "The unit's measure of size",
        "The unit's response rate only",
        "The sample mean",
        "The order of interview"
      ],
      "answer": "A",
      "explanation": "PPS assigns probabilities in proportion to a measure of size."
    },
    {
      "id": "sampling-t6-m02",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t6",
      "stem": "In PPS with replacement, p_i denotes:",
      "options": [
        "Final inclusion probability",
        "Per-draw selection probability",
        "Probability of response",
        "Pairwise inclusion probability"
      ],
      "answer": "B",
      "explanation": "p_i is the probability of selecting unit i on one draw."
    },
    {
      "id": "sampling-t6-m03",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t6",
      "stem": "Which estimator is used for independent PPS draws with replacement?",
      "options": [
        "Horvitz–Thompson",
        "Yates–Grundy",
        "Hansen–Hurwitz",
        "Ratio estimator only"
      ],
      "answer": "C",
      "explanation": "HH averages inverse draw-probability contributions over draws."
    },
    {
      "id": "sampling-t6-m04",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t6",
      "stem": "Which estimator uses final inclusion probabilities π_i?",
      "options": [
        "Hansen–Hurwitz",
        "Sample mean",
        "Regression estimator",
        "Horvitz–Thompson"
      ],
      "answer": "D",
      "explanation": "HT weights each selected unit by its final inclusion probability."
    },
    {
      "id": "sampling-t6-m05",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t6",
      "stem": "A PPSWR sample:",
      "options": [
        "May contain repeated units",
        "Must contain distinct units",
        "Has π_i=p_i always",
        "Cannot estimate a total"
      ],
      "answer": "A",
      "explanation": "With replacement allows a unit to be drawn more than once."
    },
    {
      "id": "sampling-t6-m06",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t6",
      "stem": "In cumulative-total PPS selection, the random number is generated on:",
      "options": [
        "The response scale",
        "The cumulative size scale",
        "The sample variance scale",
        "The unit index scale only"
      ],
      "answer": "B",
      "explanation": "Cumulative intervals have lengths proportional to size measures."
    },
