    {
      "id": "rprog-t4-m-01",
      "diff": "easy",
      "format": "single",
      "topic": "rprog-t4",
      "stem": "matrix(1:6,nrow=2) has first row:",
      "options": [
        "1,3,5",
        "1,2,3",
        "2,4,6",
        "6,5,4"
      ],
      "answer": "A",
      "explanation": "R fills down columns, so the first row takes the first entry of each column."
    },
    {
      "id": "rprog-t4-m-02",
      "diff": "easy",
      "format": "single",
      "topic": "rprog-t4",
      "stem": "For a matrix with 3 rows and 4 columns, dim(A) is:",
      "options": [
        "c(4,3)",
        "c(3,4)",
        "c(12)",
        "c(7)"
      ],
      "answer": "B",
      "explanation": "dim(A) reports the row count first and the column count second. For a 3-row, 4-column matrix, dim(A)=c(3,4)."
    },
    {
      "id": "rprog-t4-m-03",
      "diff": "easy",
      "format": "single",
      "topic": "rprog-t4",
      "stem": "Which operator performs matrix multiplication?",
      "options": [
        "*",
        "/",
        "%*%",
        "^"
      ],
      "answer": "C",
      "explanation": "%*% is R's matrix multiplication operator. The ordinary * operator instead multiplies corresponding entries."
    },
    {
      "id": "rprog-t4-m-04",
      "diff": "easy",
      "format": "single",
      "topic": "rprog-t4",
      "stem": "t(A) performs:",
      "options": [
        "Inverse",
        "Determinant",
        "Element-wise square",
        "Transpose"
      ],
      "answer": "D",
      "explanation": "Transpose exchanges rows and columns. A matrix with dimensions 2 by 3 becomes 3 by 2."
    },
    {
      "id": "rprog-t4-m-05",
      "diff": "easy",
      "format": "single",
      "topic": "rprog-t4",
      "stem": "For [[a,b],[c,d]], det(A) is:",
      "options": [
        "ad−bc",
        "ab−cd",
        "ac−bd",
        "a+d"
      ],
      "answer": "A",
      "explanation": "The determinant of a 2 by 2 matrix is ad minus bc. A nonzero determinant means it is nonsingular."
    },
    {
      "id": "rprog-t4-m-06",
      "diff": "easy",
      "format": "single",
      "topic": "rprog-t4",
      "stem": "A[2,3] selects:",
      "options": [
        "Column 2",
        "Entry row 2 column 3",
        "Row 3",
        "All entries"
      ],
      "answer": "B",
      "explanation": "The first subscript is row; the second is column."
    },
    {
      "id": "rprog-t4-m-07",
      "diff": "moderate",
      "format": "single",
      "topic": "rprog-t4",
      "stem": "A is 2×3 and B is 3×5. Dimension of A%*%B:",
      "options": [
        "3×3",
        "2×3",
        "2×5",
        "5×2"
      ],
      "answer": "C",
      "explanation": "The inner dimensions match; outer dimensions give 2×5."
    },
    {
      "id": "rprog-t4-m-08",
      "diff": "moderate",
      "format": "single",
      "topic": "rprog-t4",
      "stem": "For [[1,2],[3,4]], rowSums(A) is:",
      "options": [
        "c(4,6)",
        "c(1,4)",
        "c(2,6)",
        "c(3,7)"
      ],
      "answer": "D",
      "explanation": "Row totals are 3 and 7. Add across each row to obtain these two totals."
    },
