      "id": "rprog-t4-m-09",
      "diff": "moderate",
      "format": "single",
      "topic": "rprog-t4",
      "stem": "For [[1,2],[3,4]], colSums(A) is:",
      "options": [
        "c(4,6)",
        "c(3,7)",
        "c(1,4)",
        "c(2,3)"
      ],
      "answer": "A",
      "explanation": "Column totals are 4 and 6. Add down each column to obtain these totals."
    },
