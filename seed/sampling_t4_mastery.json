    {
      "id": "sampling-t4-m01",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t4",
      "stem": "In one-stage cluster sampling, the primary sampling unit is:",
      "options": [
        "An individual element",
        "A cluster",
        "A response category",
        "A measurement occasion"
      ],
      "answer": "B",
      "explanation": "The design selects groups as primary sampling units."
    },
    {
      "id": "sampling-t4-m02",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t4",
      "stem": "What is observed in a selected cluster in one-stage sampling?",
      "options": [
        "One element only",
        "A fixed fraction",
        "Every element",
        "Only the cluster mean"
      ],
      "answer": "C",
      "explanation": "One-stage cluster sampling observes all elements in each selected cluster."
    },
    {
      "id": "sampling-t4-m03",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t4",
      "stem": "The total estimator under SRS of clusters is:",
      "options": [
        "n t̄_s",
        "Nȳ_s",
        "M/n",
        "M t̄_s"
      ],
      "answer": "D",
      "explanation": "The sample mean cluster total is expanded by M."
    },
    {
      "id": "sampling-t4-m04",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t4",
      "stem": "The cluster sampling fraction is:",
      "options": [
        "n/M",
        "M/n",
        "n/N",
        "N/M"
      ],
      "answer": "A",
      "explanation": "It is the number of selected clusters divided by M."
    },
    {
      "id": "sampling-t4-m05",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t4",
      "stem": "The approximate design effect is:",
      "options": [
        "1−(m−1)ρ",
        "1+(m−1)ρ",
        "m/ρ",
        "1+ρ/m"
      ],
      "answer": "B",
      "explanation": "The equal-size approximation is one plus m minus one times ICC."
    },
    {
      "id": "sampling-t4-m06",
      "diff": "easy",
      "format": "single",
      "topic": "sampling-t4",
      "stem": "A positive ICC generally:",
      "options": [
        "Reduces DEFF below one",
        "Eliminates sampling variance",
        "Makes cluster totals equal",
        "Increases DEFF"
      ],
      "answer": "D",
      "explanation": "Positive within-cluster similarity raises the design effect."
    },
