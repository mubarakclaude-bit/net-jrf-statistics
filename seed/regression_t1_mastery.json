  "label": "6.1 Hat matrix, residual maker and quadratic forms — mastery test",
  "count": 20,
  "items": [
    {
      "id": "regression-t1-m-01",
      "diff": "easy",
      "format": "single",
      "topic": "regression-t1",
      "stem": "If X is n×k with full column rank, the hat matrix H is:",
      "options": [
        "n×n",
        "k×k",
        "n×k",
        "k×n"
      ],
      "answer": "A",
      "explanation": "H maps the n-dimensional response vector y to the n-dimensional fitted vector."
    },
    {
      "id": "regression-t1-m-02",
      "diff": "easy",
      "format": "single",
      "topic": "regression-t1",
      "stem": "The hat matrix is defined by:",
      "options": [
        "X(X′X)⁻¹X′",
        "X′X",
        "(X′X)⁻¹X",
        "I−X(X′X)⁻¹X′"
      ],
      "answer": "A",
      "explanation": "The OLS fitted vector is Xβ̂=X(X′X)⁻¹X′y=Hy."
    },
    {
      "id": "regression-t1-m-03",
      "diff": "easy",
      "format": "single",
      "topic": "regression-t1",
      "stem": "The residual-maker matrix is:",
      "options": [
        "I−H",
        "I+H",
        "H−I",
        "H⁻¹"
      ],
      "answer": "A",
      "explanation": "M=I−H."
    },
    {
      "id": "regression-t1-m-04",
      "diff": "easy",
      "format": "single",
      "topic": "regression-t1",
      "stem": "Which property does the hat matrix satisfy?",
      "options": [
        "H²=H",
        "H²=I",
        "H′=−H",
        "H⁻¹=H"
      ],
      "answer": "A",
      "explanation": "A projection matrix is idempotent."
    },
    {
      "id": "regression-t1-m-05",
      "diff": "easy",
      "format": "numeric",
      "topic": "regression-t1",
      "stem": "If n=20 and rank(X)=4, what is tr(M)?",
      "options": [
        "16",
        "4",
        "20",
        "24"
      ],
      "answer": "A",
      "explanation": "tr(M)=n−k=16.",
      "check": "16"
    },
    {
      "id": "regression-t1-m-06",
      "diff": "easy",
      "format": "numeric",
      "topic": "regression-t1",
      "stem": "If rank(X)=3, what is tr(H)?",
      "options": [
        "1",
        "3",
        "2",
        "n−3"
      ],
      "answer": "B",
      "explanation": "tr(H)=rank(H)=rank(X)=3.",
      "check": "3"
    },
    {
      "id": "regression-t1-m-07",
      "diff": "moderate",
      "format": "single",
      "topic": "regression-t1",
      "stem": "The residual vector is:",
      "options": [
        "Hy",
        "My",
        "Xy",
        "Mβ"
      ],
      "answer": "B",
      "explanation": "e=y−Hy=(I−H)y=My."
    },
    {
      "id": "regression-t1-m-08",
      "diff": "moderate",
      "format": "single",
      "topic": "regression-t1",
      "stem": "Which identity expresses residual orthogonality to the regressors?",
      "options": [
        "Xe=0",
        "X′e=0",
        "H′e=e",
        "M′X=I"
      ],
      "answer": "B",
      "explanation": "OLS residuals are orthogonal to every column of X."
    },
    {
      "id": "regression-t1-m-09",
      "diff": "moderate",
      "format": "single",
      "topic": "regression-t1",
      "stem": "For full-column-rank X with k columns, rank(H) is:",
      "options": [
        "n",
        "k",
        "n−k",
        "1"
      ],
      "answer": "B",
      "explanation": "H projects onto C(X), whose dimension is k."
    },
    {
