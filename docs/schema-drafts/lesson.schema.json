{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://net-jrf-statistics.invalid/schema-drafts/lesson.schema.json",
  "title": "NET JRF Statistics lesson seed (non-binding draft)",
  "description": "Permissive structural draft based on the complete 48-lesson seed inventory. Additional properties remain allowed to preserve legacy and future teaching extensions. Not enabled as a CI gate.",
  "type": "object",
  "required": [
    "id",
    "title",
    "moduleId",
    "estMin",
    "scenes",
    "status",
    "version",
    "topicId"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "moduleId": {
      "type": "string",
      "minLength": 1
    },
    "topicId": {
      "type": "string",
      "minLength": 1
    },
    "estMin": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "breadcrumb": {
      "type": "string"
    },
    "engine": {
      "type": "string"
    },
    "engineName": {
      "type": "string"
    },
    "howto": {
      "type": "string"
    },
    "provenance": {
      "type": "string"
    },
    "objectives": {
      "type": "array"
    },
    "prereq": {
      "type": "array"
    },
    "traps": {
      "type": "array"
    },
    "refs": {
      "type": "array"
    },
    "revision": {
      "type": "object"
    },
    "mastery": {
      "type": "object"
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "foundation",
            "intuition",
            "theory",
            "recall",
            "completion",
            "guided",
            "trapcheck",
            "summary",
            "quiz",
            "explore",
            "worked"
          ]
        },
        "title": {
          "type": "string"
        },
        "mins": {
          "type": "number",
          "minimum": 0
        },
        "objective": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "blocks": {
          "type": "array"
        },
        "ask": {},
        "problem": {},
        "solution": {},
        "steps": {
          "type": "array"
        },
        "answer": {},
        "check": {},
        "hints": {
          "type": "array"
        },
        "items": {
          "type": "array"
        },
        "flow": {},
        "scenario": {},
        "setId": {
          "type": "string"
        },
        "after": {},
        "ext": {},
        "table": {},
        "viz": {}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
