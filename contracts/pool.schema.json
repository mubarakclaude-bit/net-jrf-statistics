{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://net-jrf-statistics/contracts/pool.schema.json",
  "title": "Question set (contract v1)",
  "$comment": "STRUCTURE only. Mastery-only rules (20 items, difficulty mix, key spread, 4 options everywhere) are in mastery-pool.schema.json and vcheck.js; they are NOT universal. Seeds that legitimately deviate are listed, with a reason, in contracts/legacy-exceptions.json so a defect is visible and cannot be copied into new content.",
  "type": "object",
  "required": ["moduleId", "source", "label", "count", "items"],
  "properties": {
    "moduleId": { "type": "string", "pattern": "^[a-z0-9]+$" },
    "topicId": { "type": ["string", "null"], "pattern": "^[a-z0-9]+-[a-z0-9]+$", "$comment": "null for a whole past paper, which spans topics" },
    "source": { "enum": ["mastery", "variant", "pyq"], "$comment": "mastery: a lesson's unseen test; variant: practice variants of a past question; pyq: the real past paper" },
    "label": { "type": "string", "minLength": 1 },
    "count": { "type": "integer", "minimum": 1, "$comment": "must equal items.length (checked by tools/validate-contracts.js)" },
    "clean": { "type": "integer" },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } }
  },
  "allOf": [
    {
      "$comment": "PRIVACY: the candidate's own answers may exist only in the real past paper (source pyq). The public build scrubs them; this rule keeps them from spreading to any other set.",
      "if": { "properties": { "source": { "not": { "const": "pyq" } } }, "required": ["source"] },
      "then": { "properties": { "items": { "items": { "not": { "anyOf": [{ "required": ["youMarked"] }, { "required": ["responseSheet"] }] } } } } }
    }
  ],
  "$defs": {
    "strs": { "type": "array", "items": { "type": "string" } },
    "verdicts": {
      "type": "object",
      "required": ["A", "B", "C", "D"],
      "properties": {
        "A": { "$ref": "#/$defs/verdict" }, "B": { "$ref": "#/$defs/verdict" }, "C": { "$ref": "#/$defs/verdict" }, "D": { "$ref": "#/$defs/verdict" }
      }
    },
    "verdict": { "type": "object", "required": ["tf", "why"], "properties": { "tf": { "type": "boolean" }, "why": { "type": "string" } } },
    "item": {
      "type": "object",
      "required": ["id", "format", "stem", "options", "answer", "explanation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "format": { "enum": ["single", "numeric", "multi", "match", "order"] },
        "stem": { "type": "string", "minLength": 1 },
        "options": { "$ref": "#/$defs/strs" },
        "answer": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1 },
        "topic": { "type": "string" }, "moduleId": { "type": "string" },
        "diff": { "enum": ["easy", "moderate", "hard"] },
        "check": { "type": "string" },
        "statements": { "$ref": "#/$defs/strs" }, "verdicts": { "$ref": "#/$defs/verdicts" },
        "pairs": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } } },
        "items": { "$ref": "#/$defs/strs" },
        "srcQ": { "type": "integer" }, "paper": { "type": "integer" }, "pno": { "type": "integer" }, "year": { "type": ["integer", "string"] },
        "repaired": { "type": "string" },
        "youMarked": { "type": "string" }, "responseSheet": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "format": { "const": "single" } }, "required": ["format"] },
          "then": { "properties": { "options": { "minItems": 4, "maxItems": 4 }, "answer": { "pattern": "^[A-D]$" } } } },
        { "if": { "properties": { "format": { "const": "numeric" } }, "required": ["format"] },
          "then": { "required": ["check"], "$comment": "a terminal sanity line usable under exam pressure; a numeric item with no options is a write-in",
                    "properties": { "options": { "maxItems": 4 } } } },
        { "if": { "properties": { "format": { "const": "multi" } }, "required": ["format"] },
          "then": { "required": ["statements", "verdicts"], "properties": { "options": { "minItems": 4, "maxItems": 4 }, "answer": { "pattern": "^[A-D]$" },
                    "statements": { "minItems": 4, "maxItems": 4 } } } },
        { "if": { "properties": { "format": { "const": "match" } }, "required": ["format"] },
          "then": { "required": ["pairs"], "properties": { "options": { "minItems": 4, "maxItems": 4 }, "answer": { "pattern": "^[A-D]$" }, "pairs": { "minItems": 4, "maxItems": 4 } } } },
        { "if": { "properties": { "format": { "const": "order" } }, "required": ["format"] },
          "then": { "required": ["items"], "properties": { "options": { "minItems": 4, "maxItems": 4 }, "answer": { "pattern": "^[A-D]$" }, "items": { "minItems": 4, "maxItems": 4 } } } }
      ]
    }
  }
}
